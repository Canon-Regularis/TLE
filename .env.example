# Whether members may register themselves as duelists, with /duel selfregister.
ALLOW_DUEL_SELF_REGISTER="false"

BOT_TOKEN="XXXXXXXXXXXXXXXXXXXXXXXX.XXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXX"
LOGGING_COG_CHANNEL_ID="XXXXXXXXXXXXXXXXXX"

# Optional. The servers the bot may be used in, by ID, comma-separated. In any
# other server its commands are refused, and if the bot is added to one, it
# leaves. Unset, it can be used in any server. Also turn off Public Bot in the
# Discord Developer Portal (under Bot), so that only you can add the bot.
# ALLOWED_GUILD_IDS="123456789012345678,234567890123456789"

# Optional. TLE's roles, each by ID or by name. Give the admin, moderator and
# trusted roles by ID: a name matches a role of that name in every server the
# bot is in, whoever made it. To copy a role's ID, turn on Developer Mode in
# Discord (User Settings > Advanced), then right-click the role. Unset, they
# are the roles named Admin, Moderator, Trusted and Purgatory. Members with
# the Manage Server permission count as admins too. README section 3 says
# what each may do.
# TLE_ADMIN="123456789012345678"
# TLE_MODERATOR="234567890123456789"
# TLE_TRUSTED="345678901234567890"
# TLE_PURGATORY="Purgatory"
# The developer role, by ID only (a name is ignored, with a warning when the
# bot starts). Its members can use the developer commands, ;kcpc status and
# ;meta git, in the staff channel, which admins can use too. Unset, only
# admins can.
# TLE_DEVELOPER="456789012345678901"

# Codeforces OAuth (OpenID Connect) — required for /handle identify
# Register your app at https://codeforces.com/settings/api to obtain these.
OAUTH_CLIENT_ID="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
OAUTH_CLIENT_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
OAUTH_REDIRECT_URI="http://localhost:8080/callback"
OAUTH_SERVER_PORT="8080"

# Optional. Extensions (e.g. tle.duel) or whole families (tle, kcpc) to switch off, comma-separated.
# DISABLED_EXTENSIONS="tle.duel,tle.graphs,tle.starboard"

# KCPC club features (tle/kcpc). All optional.
# Where a setting has a default it is shown; the others are examples.
# The club's time zone, for schedules and for times that admins type.
# KCPC_TIMEZONE="Europe/London"
# Where the KCPC database lives. Under Docker, keep it inside data/, the mounted folder.
# KCPC_DB_PATH="data/db/kcpc.db"
# The User-Agent of KCPC's requests to other sites (AtCoder, Luma, icpc.global, ...).
# HTTP_USER_AGENT="KCPC-bot (+https://github.com/Canon-Regularis/TLE)"
# The default Luma calendar, for servers that haven't set one with /kcpc workshops calendar.
# Its ID (cal-...), which is also the id= in the calendar's iCal link.
# LUMA_CALENDAR_ID="cal-XXXXXXXXXXXXXXX"
# icpc.global contests to track, comma-separated, by their abbreviation on
# icpc.global (UKIEPC is the UK & Ireland Programming Contest). icpc.global gives
# only their dates: until the bot owner sets a contest's time with
# /kcpc contests settime, it shows as "time TBA" and gets no reminders.
# ICPC_CONTEST_CODES="UKIEPC,Northwestern-Europe-2027"
# A clist.by account (free). With both set, the bot also tracks CodeChef,
# LeetCode, TopCoder and the ICPC World Finals through clist.by. The API key
# is on https://clist.by/api/v4/doc/ once you are signed in.
# CLIST_USERNAME="XXXXXXXX"
# CLIST_API_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
